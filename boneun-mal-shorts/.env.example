# ------------------------------------------------------------------
# 보이는 말 / BONEUN MAL — environment template
# Copy to .env and fill in locally. NEVER commit a real key.
#   cp .env.example .env
# ------------------------------------------------------------------

# --- KCISA / 문화체육관광부 한국수어 OpenAPI (REQUIRED) ---------------
# Issued at https://www.kcisa.kr / https://www.data.go.kr
# Without this key the pipeline stops with KSL_DATA_UNAVAILABLE.
# It never invents sign language data to fill the gap.
KCISA_SERVICE_KEY=

# Endpoint override (defaults are already correct; change only if KCISA moves it)
KCISA_BASE_URL=https://api.kcisa.kr/openapi/service/rest/meta13
KCISA_OPERATION=getCTE01701
KCISA_TIMEOUT_MS=15000
KCISA_MAX_RETRIES=3
KCISA_ROWS_PER_PAGE=50
KCISA_CACHE_TTL_HOURS=168
# getCTE01701's server-side keyword filter does not work (confirmed 2026-08-19:
# every parameter name tried returns the same unfiltered page 1). Word lookups
# page through the listing and match client-side; this caps how many records
# that scan will pull before giving up. ~3750 total records exist today.
KCISA_MAX_SCAN_RECORDS=4000

# --- YouTube Data API v3 (OPTIONAL — only for npm run youtube:upload) --
# OAuth 2.0 "Desktop app" client + a refresh token with
# scopes: youtube.upload, youtube.force-ssl
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Uploads are always created private. Never set this to public.
YOUTUBE_PRIVACY_STATUS=private

# --- Local tooling overrides (OPTIONAL) ------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Absolute path to a Korean-capable font used for burn-in subtitles.
# Leave empty to auto-detect from config/brand.json candidates.
KOREAN_FONT_FILE=
LOG_LEVEL=info
